{
  "openapi": "3.0.3",
  "info": {
    "title": "MasterMusic.Ventas.Api — pedidos",
    "version": "1.0.0",
    "description": "API independiente con MasterMusicVentasDB. Consume inventario mediante cliente HTTP tipado e IHttpClientFactory. Timeout de cinco segundos por llamada. Contrato objetivo del Trabajo 3: no certifica implementación. Importes enteros en pesos chilenos. Sin pagos en línea."
  },
  "servers": [
    {
      "url": "/",
      "description": "Origen HTTPS de esta API; configurar host y puerto del entorno."
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/v1.0/Pedidos": {
      "post": {
        "operationId": "crearPedido",
        "summary": "Registrar pedido propio",
        "description": "Obtiene idCliente del JWT. Persiste OperacionPedido y comando antes del HTTP. Si descuento confirmado, guarda pedido, detalles y operación completada en transacción local. Total calculado por servidor; no acepta total ni idCliente. Resultado terminal rechazado conserva error para reintentos. Selección y resumen se editan localmente en React. No hay pago. Si respuesta se pierde, consultar por clave. Nunca reutilizar una clave para una selección modificada.",
        "tags": [
          "Pedidos"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-roles": [
          "Cliente"
        ],
        "x-requisitos": [
          "RF-14",
          "RF-15",
          "RF-16",
          "RF-17",
          "RF-21",
          "RF-22"
        ],
        "responses": {
          "200": {
            "description": "Reintento de alta completada: mismo pedido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pedido"
                }
              }
            }
          },
          "201": {
            "description": "Pedido aceptado Pendiente; no acredita pago.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pedido"
                }
              }
            }
          },
          "202": {
            "description": "Operación durable en proceso o con resultado incierto; NO acredita pedido aceptado ni cancelación. Conservar clave y consultar/recuperar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operacion"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Ruta a GET Operaciones/{idOperacion}.",
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "description": "Segundos sugeridos antes de consultar.",
                "schema": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 1
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales ausentes, inválidas o expiradas; login no aceptado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "403": {
            "description": "Identidad válida sin permiso.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "404": {
            "description": "Recurso inexistente o no visible para el usuario.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto de negocio, concurrencia o clave reutilizada con contenido diferente.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "503": {
            "description": "Servicio no disponible; no interpretar como éxito.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "UUID generado por React para este comando. Reutilizar en reintentos del mismo comando, incluso tras pérdida de respuesta. Alcance: usuario autenticado + tipo de operación + clave. Cambio de contenido: 409.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoCrear"
              }
            }
          }
        }
      },
