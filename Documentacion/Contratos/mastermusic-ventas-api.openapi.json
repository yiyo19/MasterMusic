    "/api/v1.0/Operaciones/{idOperacion}": {
      "get": {
        "operationId": "consultarOperacion",
        "summary": "Consultar progreso técnico",
        "description": "Solo creador de la operación. 404 para ajena. GET no ejecuta movimientos ni recuperación. Completada contiene pedido; Rechazada o Compensada contiene problema. No expone solicitud_json, huella ni credenciales.",
        "tags": [
          "Operaciones"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-roles": [
          "Cliente",
          "Administrador"
        ],
        "x-requisitos": [
          "RF-22"
        ],
        "responses": {
          "200": {
            "description": "Estado actual; examinar estadoOperacion, no solo HTTP 200.",
            "content": {
