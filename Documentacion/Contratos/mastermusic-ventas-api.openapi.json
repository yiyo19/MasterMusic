  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Validar firma, emisor, audiencia y expiración."
      }
    },
    "schemas": {
      "Pedido": {
        "type": "object",
        "properties": {
          "idPedido": {
            "type": "string",
            "format": "uuid"
          },
          "idCliente": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "fecha": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora UTC."
          },
          "estado": {
            "type": "string",
            "enum": [
              "Pendiente",
              "Confirmado",
              "Cancelado"
            ]
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Suma de cantidad × precioUnitario, en pesos CLP; máximo 9007199254740991 para representación exacta en React.",
            "maximum": 9007199254740991
          },
          "motivoCancelacion": {
            "type": "string",
            "nullable": true,
            "maxLength": 500
          },
          "detalles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DetallePedido"
            },
            "minItems": 1
          }
        },
        "required": [
          "idPedido",
          "idCliente",
          "fecha",
          "estado",
          "total",
          "motivoCancelacion",
          "detalles"
        ],
        "additionalProperties": false
      },
      "DetallePedido": {
        "type": "object",
        "properties": {
          "idInstrumento": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "nombreInstrumento": {
            "type": "string"
          },
          "cantidad": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "precioUnitario": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          }
        },
        "required": [
          "idInstrumento",
          "nombreInstrumento",
          "cantidad",
          "precioUnitario"
        ],
        "additionalProperties": false
      },
      "Operacion": {
        "type": "object",
        "properties": {
          "idOperacion": {
            "type": "string",
            "format": "uuid"
          },
          "claveCliente": {
            "type": "string",
            "format": "uuid"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "Crear",
              "Confirmar",
              "Cancelar"
            ]
          },
          "estadoOperacion": {
            "type": "string",
            "enum": [
              "EnProceso",
              "Completada",
              "Rechazada",
              "EnCompensacion",
              "Compensada"
            ]
          },
          "idPedido": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "fechaCreacion": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora UTC."
          },
          "fechaActualizacion": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora UTC."
          },
          "recuperable": {
            "type": "boolean"
          },
          "codigoResultado": {
            "type": "string",
            "nullable": true
          },
          "pedido": {
            "$ref": "#/components/schemas/Pedido"
          },
          "problema": {
            "$ref": "#/components/schemas/Problema"
          }
        },
        "required": [
          "idOperacion",
          "claveCliente",
          "tipo",
          "estadoOperacion",
          "idPedido",
          "fechaCreacion",
          "fechaActualizacion",
          "recuperable",
          "codigoResultado"
        ],
        "additionalProperties": false
      },
      "Problema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference",
            "default": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "codigo": {
            "type": "string",
            "description": "Código estable de negocio; véase README.md."
          },
          "traceId": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "preciosActualizados": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "idInstrumento": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 1
                },
                "precioActual": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 1
                }
              },
              "required": [
                "idInstrumento",
                "precioActual"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "codigo"
        ],
        "additionalProperties": false
      },
      "PedidoCrear": {
        "type": "object",
        "properties": {
          "lineas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineaSolicitud"
            },
            "minItems": 1,
            "description": "Instrumentos sin repetir. Precios enteros CLP; el servidor verifica precio vigente antes de descontar."
          }
        },
        "required": [
          "lineas"
        ],
        "additionalProperties": false,
        "description": "Validar suma con aritmética comprobada antes de solicitar descuento: total máximo 9007199254740991 CLP. Exceso: 400 TOTAL_FUERA_DE_RANGO. No aceptar identificadores repetidos."
      },
      "LineaSolicitud": {
        "type": "object",
        "properties": {
          "idInstrumento": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "cantidad": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "precioEsperado": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          }
        },
        "required": [
          "idInstrumento",
          "cantidad",
          "precioEsperado"
        ],
        "additionalProperties": false
      },
      "Cancelacion": {
        "type": "object",
        "properties": {
          "motivo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          }
        },
        "required": [
          "motivo"
        ],
        "additionalProperties": false
      }
    }
  }
