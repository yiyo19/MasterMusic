# MasterMusic — referencia de configuración de las APIs.
# No se carga automáticamente: usar variables de entorno según README.md.
# Mantener Jwt__Key, Inventario__ServiceKey y credenciales privadas fuera de Git.
# Las dos claves se generan en el bloque de configuración del README.

ConnectionStrings__MasterMusic=Server=.\SQLEXPRESS;Database=MasterMusicDB;Integrated Security=True;Encrypt=True;TrustServerCertificate=True
ConnectionStrings__MasterMusicVentas=Server=.\SQLEXPRESS;Database=MasterMusicVentasDB;Integrated Security=True;Encrypt=True;TrustServerCertificate=True

Jwt__Key=
Jwt__Issuer=MasterMusicApi
Jwt__Audience=MasterMusicClients
Jwt__ExpireMinutes=60

Admin__Email=
Admin__Password=

Inventario__BaseUrl=https://localhost:7052/
Inventario__ServiceKey=
Cors__AllowedOrigins__0=http://localhost:5173

# Los perfiles https de launchSettings.json establecen Development.
# Las pruebas SQL requieren una instancia con permisos para crear bases temporales.
# MASTERMUSIC_TEST_SQL=Server=.\SQLEXPRESS;Database=master;Integrated Security=True;Encrypt=True;TrustServerCertificate=True

# React usa su propia plantilla MasterMusic.Client/.env.example.
# Las variables VITE_ son públicas y nunca deben incluir secretos.
